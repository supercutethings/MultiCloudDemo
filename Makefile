# Single entrypoint for the platform. Every target works from a fresh clone.
SHELL := /bin/bash
.DEFAULT_GOAL := help

PROJECT   ?= showcase
ENVIRONMENT ?= dev
CLOUD     ?= eks
SCENARIO  ?= login
CONCURRENCY ?= 40
DURATION  ?= 60
CERT_DIR  ?= .certs
# Internal data port: compose publishes auth's 8443 as 8001 on the host.
MTLS_URL  ?= https://localhost:8001
TF_DIR    := infra/envs/aws/dev
# Prefer the project interpreter when one exists: a bare `python3` on a machine with
# an older system Python cannot read pyproject.toml's pythonpath setting.
PYTHON    ?= $(shell if [ -x .venv/bin/python ]; then echo .venv/bin/python; else echo python3; fi)
LOCAL_URL ?= http://localhost:8080
# Generated by `terraform output -raw backend_hcl` in infra/bootstrap/aws.
BACKEND   := $(if $(wildcard $(TF_DIR)/backend.hcl),-backend-config=backend.hcl,)

.PHONY: help keys certs up down logs ps test lint fmt smoke plan apply destroy cost backend \
        k8s-render k8s-deploy k8s-addons loadtest certs-expiry loadtest-mtls loadtest-rotate

help: ## Show available targets
	@grep -E '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-10s\033[0m %s\n", $$1, $$2}'

keys: ## Generate the local RS256 key pair (idempotent)
	@bash scripts/gen-keys.sh

certs: ## Generate the local mTLS CA and leaf certificates (idempotent)
	@bash scripts/gen-certs.sh

up: keys certs ## Start the full stack locally with Docker Compose
	docker compose up -d --build
	@echo "gateway: $(LOCAL_URL)  (auth :8001, catalog :8002, db :5432)"

down: ## Stop the local stack and remove volumes
	docker compose down -v

logs: ## Follow logs from every service
	docker compose logs -f --tail=50

ps: ## Show local container status
	docker compose ps

test: ## Run application unit tests
	$(PYTHON) -m pytest

lint: ## Lint the Python code
	$(PYTHON) -m ruff check apps

fmt: ## Format Python and Terraform
	ruff format apps
	terraform -chdir=$(TF_DIR) fmt -recursive || true

smoke: ## End-to-end check against a running gateway (local or deployed)
	@bash scripts/smoke.sh $(LOCAL_URL)

mtls-check: ## Prove the internal hop rejects callers without a client certificate
	@bash scripts/mtls-check.sh $(MTLS_URL)

certs-expiry: ## Fail if any internal certificate expires within 7 days
	@bash scripts/cert-expiry.sh $(CERT_DIR)

loadtest-mtls: ## Measure TLS handshake cost on the internal data port (MTLS_URL)
	python3 scripts/loadtest.py --url $(MTLS_URL) --scenario handshake --duration $(DURATION) \
		--ca-file $(CERT_DIR)/server-ca.crt --cert-file $(CERT_DIR)/gateway/tls.crt \
		--key-file $(CERT_DIR)/gateway/tls.key

loadtest-rotate: ## Swap the caller certificate mid-run: an unlisted issuer must be refused
	python3 scripts/loadtest.py --url $(MTLS_URL) --scenario rotate --duration 20 \
		--ca-file $(CERT_DIR)/server-ca.crt --cert-file $(CERT_DIR)/gateway/tls.crt \
		--key-file $(CERT_DIR)/gateway/tls.key \
		--rotate-cert $(CERT_DIR)/unlisted-client/tls.crt \
		--rotate-key $(CERT_DIR)/unlisted-client/tls.key --rotate-expect failure

backend: ## Write the remote-state config from the bootstrap outputs
	terraform -chdir=infra/bootstrap/aws output -raw backend_hcl > $(TF_DIR)/backend.hcl
	@echo "wrote $(TF_DIR)/backend.hcl"

plan: ## Terraform plan (AWS dev)
	cd $(TF_DIR) && terraform init -input=false $(BACKEND) && terraform plan -input=false -out=tfplan

apply: ## Terraform apply (AWS dev) using the saved plan
	cd $(TF_DIR) && terraform apply -input=false tfplan

destroy: ## Tear down everything (cost control - run this!)
	cd $(TF_DIR) && terraform destroy -auto-approve

k8s-render: ## Render the Kubernetes overlay for CLOUD (eks|aks|gke)
	@bash scripts/k8s-render.sh $(CLOUD)

k8s-deploy: ## Apply the rendered overlay to the current kubeconfig context
	@bash scripts/k8s-render.sh $(CLOUD) | kubectl apply -f -
	@echo "kubectl -n showcase get deploy,hpa,pods -w"

k8s-addons: ## Install cluster add-ons for CLOUD (ESO, autoscaler, ingress, metrics)
	@bash scripts/cluster-addons.sh $(CLOUD)

loadtest: ## Drive traffic at the gateway (SCENARIO, CONCURRENCY, DURATION)
	python3 scripts/loadtest.py --url $(LOCAL_URL) --scenario $(SCENARIO) \
		--concurrency $(CONCURRENCY) --duration $(DURATION)

cost: ## Show the cost model and alternatives
	@echo "See docs/cost.md - full per-cloud breakdown, free-tier status and cheaper variants."

.PHONY: mtls-check
