# Copy to terraform.tfvars (git-ignored) and adjust. Every value has a working default, so
# `terraform apply` with no tfvars is also valid -- it just picks the cheapest sizes.
project     = "showcase"
environment = "dev"
location    = "westeurope"

# Registry and vault names are globally unique; the environment appends a random suffix.
acr_sku = "Basic"

# B_Standard_B1ms is inside the 12-month free tier for new subscriptions.
db_sku     = "B_Standard_B1ms"
db_storage_mb = 32768
db_ha      = false

# Images must exist in ACR before the apps can start: build, push, then apply.
image_tag = "1.0.0"

# 0 scales to zero (free when idle, cold start on first request).
service_min_replicas = 0
service_max_replicas = 3

# One warm gateway keeps the public URL responsive for the smoke test.
gateway_min_replicas = 1
gateway_max_replicas = 10

# Restrict the vault's public endpoint once you know your egress ranges.
key_vault_allowed_ip_ranges = []
